---
// Кабинет (пока — профиль): одна карточка по центру — аватар, имя, роль, данные, способы входа, «Выйти».
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import Avatar from '../components/Avatar.astro';
import { ROLE_TITLE } from '../lib/auth';
import { getHome } from '../lib/api';
import '../styles/auth.css';

const me = Astro.locals.me;
if (!me) return Astro.redirect('/login', 303);
if (!me.user.onboarded) return Astro.redirect('/login?step=profile', 303);
Astro.response.headers.set('Cache-Control', 'private, no-store');

const u = me.user;
let titles: Record<string, string> = {};
if (u.spheres.length) {
  try {
    titles = Object.fromEntries((await getHome()).categories.map((c) => [c.slug, c.title]));
  } catch {
    /* без справочника покажем slug */
  }
}
const PROVIDERS: Record<string, string> = { email: 'Почта', telegram: 'Telegram', google: 'Google' };
const href = (c: string) => (c.startsWith('@') ? `https://t.me/${c.slice(1)}` : c);
const label = (c: string) => c.replace(/^https?:\/\//, '').replace(/\/$/, '');
const hasTelegram = me.providers.includes('telegram');
---
<Base title="Кабинет — Охват" description="Ваш кабинет в Охвате." noindex>
  <Header />
  <main class="au au-acc" data-auth>
    <div class="au-card acc">
      <div class="acc-head">
        <Avatar user={u} size={72} />
        <h1>{u.name}</h1>
        <p class="acc-meta">
          <span class="role-b"><Icon name={u.role === 'creator' ? 'video' : 'store'} size={18} />{u.role ? ROLE_TITLE[u.role] : 'Кабинет'}</span>
          {u.city && <span class="city"><Icon name="map-pin" size={18} />{u.city}</span>}
        </p>
      </div>
      <dl class="rows">
        {u.role === 'business' && (
          <div><dt>Сфера</dt><dd class="tags">{u.spheres.map((s) => <span class="chip is-static">{titles[s] ?? s}</span>)}</dd></div>
        )}
        {u.role === 'creator' && (
          <div><dt>Каналы</dt><dd class="links">{u.channels.map((c) => <a href={href(c)} rel="noopener nofollow ugc" target="_blank">{label(c)}</a>)}</dd></div>
        )}
        <div><dt>Почта</dt><dd>{u.email ?? 'не указана'}</dd></div>
        <div><dt>Вход</dt><dd>{me.providers.map((p) => PROVIDERS[p] ?? p).join(', ')}</dd></div>
        <div><dt>Уведомления</dt><dd>{hasTelegram ? 'в Telegram-боте' : 'войдите через Telegram, чтобы получать их в боте'}</dd></div>
      </dl>
      <p class="ferr" data-err="form" role="alert"></p>
      <button class="btn way" type="button" data-logout><Icon name="log-out" size={20} /><span>Выйти</span></button>
    </div>
  </main>
</Base>
<script src="../scripts/auth.ts"></script>
