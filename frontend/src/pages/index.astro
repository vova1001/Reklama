---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import How from '../components/How.astro';
import Head from '../components/Head.astro';
import Plans from '../components/Plans.astro';
import Topics from '../components/Topics.astro';
import Why from '../components/Why.astro';
import ZoneHead from '../components/ZoneHead.astro';
import ZoneNav from '../components/ZoneNav.astro';
import Promo from '../components/Promo.astro';
import AutHow from '../components/AutHow.astro';
import AutFeatures from '../components/AutFeatures.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { getHome } from '../lib/api';
import { BIZ, AUT } from '../content/home';

let home;
try {
  home = await getHome();
} catch (err) {
  console.error('главная: API недоступно', err);
  return new Response('Сервис временно недоступен. Обновите страницу через минуту.', {
    status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Retry-After': '30' },
  });
}
// шапка зависит от входа — страница не кэшируется общим кэшем и всегда сверяется
Astro.response.headers.set('Cache-Control', 'private, no-cache');
---
<Base
  title="Охват — реклама у авторов видео с оплатой за результат"
  description="Разместите задание с условиями: автор снимет ролик, сервис проверит просмотры и сам переведёт оплату. Начните бесплатно."
>
  <Header />
  <ZoneNav />
  <main>
    <Hero />
    <Why />
    <section class="zone light biz-zone" id="business" data-zone="business" aria-label="Для бизнеса">
      <div class="w">
        <ZoneHead icon="store" eyebrow={BIZ.eyebrow} title={BIZ.title} lead={BIZ.lead} />
        <How />
        <Promo />
        <div class="blk biz" id="pricing">
          <Head level={3} title="Тарифы для бизнеса" />
          <Plans plans={home.businessPlans} />
        </div>
      </div>
    </section>
    <section class="zone on-dark sheet aut-zone" id="creators" data-zone="creators" aria-label="Для авторов">
      <div class="w">
        <ZoneHead icon="video" eyebrow={AUT.eyebrow} title={AUT.title} lead={AUT.lead} />
        <AutHow />
        <AutFeatures />
        <div class="blk aut" id="creator-pricing">
          <Head level={3} title="Тарифы для авторов" />
          <Plans plans={home.creatorPlans} dark />
        </div>
      </div>
    </section>
    <section class="zone light sheet">
      <div class="w">
        <Topics categories={home.categories} />
        <Faq faq={home.faq} />
      </div>
    </section>
  </main>
  <Footer categories={home.categories} />
</Base>
