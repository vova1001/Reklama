---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import How from '../components/How.astro';
import Head from '../components/Head.astro';
import Plans from '../components/Plans.astro';
import Kinds from '../components/Kinds.astro';
import Topics from '../components/Topics.astro';
import Start from '../components/Start.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { getHome } from '../lib/api';

let home;
try {
  home = await getHome();
} catch (err) {
  console.error('главная: API недоступно', err);
  return new Response('Сервис временно недоступен. Обновите страницу через минуту.', {
    status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Retry-After': '30' },
  });
}
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---
<Base
  title="Охват — реклама у авторов видео с оплатой за результат"
  description="Разместите задание с условиями: автор снимет ролик, сервис проверит просмотры и лайки и сам переведёт оплату. Начните бесплатно."
>
  <Header />
  <main>
    <Hero />
    <section class="zone light sheet">
      <div class="w">
        <How />
        <div class="blk biz" id="pricing">
          <Head title="Тарифы для бизнеса" lead="Платите за размещение, а автору — только за результат." />
          <Plans plans={home.businessPlans} />
        </div>
      </div>
    </section>
    <section class="zone on-dark sheet">
      <div class="w">
        <Kinds />
        <div class="blk aut" id="creator-pricing">
          <Head title="Тарифы для авторов" lead="Больше откликов — больше заказов." />
          <Plans plans={home.creatorPlans} dark />
        </div>
      </div>
    </section>
    <section class="zone light sheet">
      <div class="w">
        <Topics categories={home.categories} />
        <Start />
        <Faq faq={home.faq} />
      </div>
    </section>
  </main>
  <Footer categories={home.categories} />
</Base>
