---
// Настройки: способы входа, уведомления, тариф, сеансы. Строки одной высоты, состояние — словом справа.
import App from '../../layouts/App.astro';
import Icon from '../../components/Icon.astro';
import { PROVIDERS } from '../../content/app';
import { fetchAuthConfig } from '../../lib/auth';

const me = Astro.locals.me;
if (!me) return Astro.redirect('/login', 303);
const cfg = await fetchAuthConfig();
const has = (p: string) => me.providers.includes(p as (typeof me.providers)[number]);
const botName = cfg.telegram?.botName ?? '';
---
<App title="Настройки" page="settings">
  <div class="head">
    <h1>Настройки</h1>
    <button class="btn pill-ghost" type="button" data-logout><Icon name="log-out" size={20} />Выйти</button>
  </div>

  <section class="sec" aria-labelledby="ways-t">
    <h2 id="ways-t" class="sec-h">Вход</h2>
    <ul class="rows">
      {PROVIDERS.map((p) => (
        <li data-provider={p.id}>
          <Icon name={p.icon} size={20} />
          <div>
            <p class="row-t">{p.title}</p>
            <p class="row-s">{has(p.id) ? (p.id === 'email' ? me.user.email : 'Подключён') : p.id !== 'telegram' && !me.user.email ? 'Нужна почта в аккаунте' : p.how}</p>
          </div>
          <span class={`row-v ${has(p.id) ? 'on' : ''}`}>{has(p.id) ? 'Есть' : 'Нет'}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="sec" id="notify" aria-labelledby="notify-t">
    <h2 id="notify-t" class="sec-h">Уведомления</h2>
    <ul class="rows">
      <li>
        <Icon name="bell-ring" size={20} />
        <div>
          <p class="row-t">Telegram{botName && <span class="row-s"> · @{botName}</span>}</p>
          <p class="row-s">{has('telegram') ? 'Выключить — /stop в боте' : 'Для тех, кто входит через Telegram'}</p>
        </div>
        <span class={`row-v ${has('telegram') ? 'on' : ''}`}>{has('telegram') ? 'Вкл.' : 'Нет'}</span>
      </li>
    </ul>
  </section>

  <section class="sec" id="plan" aria-labelledby="plan-t">
    <h2 id="plan-t" class="sec-h">Тариф</h2>
    <ul class="rows">
      <li>
        <Icon name="wallet-cards" size={20} />
        <div><p class="row-t">Бесплатный</p><p class="row-s">Больше заданий и выше в ленте — Про и Топ</p></div>
        <a class="row-v lnk" href="/pricing">Тарифы</a>
      </li>
    </ul>
  </section>

  <section class="sec" aria-labelledby="sess-t">
    <h2 id="sess-t" class="sec-h">Сеансы</h2>
    <p class="muted">Потеряли телефон или входили с чужого устройства — завершите все сеансы.</p>
    <div class="form-act" style="margin-top:12px">
      <button class="btn pill-danger-ol" type="button" data-logout-all><Icon name="monitor-smartphone" size={20} />Выйти со всех устройств</button>
    </div>
    <p class="ferr" data-err="form" role="alert"></p>
  </section>
</App>
