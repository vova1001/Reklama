---
// Лента. Автор — опубликованные задания (новые сверху, «Показать ещё»). Бизнес — свои задания на проверке и
// опубликованные, черновики — строкой со ссылкой, «Создать». Без выдуманных данных: пусто — так и говорим.
import App from '../../layouts/App.astro';
import Icon from '../../components/Icon.astro';
import Nudge from '../../components/app/Nudge.astro';
import TaskItem from '../../components/app/TaskItem.astro';
import { fetchFeed, fetchMyTasks } from '../../lib/auth';

const me = Astro.locals.me;
if (!me) return Astro.redirect('/login', 303);
const mode = me.user.mode;
const cursor = Astro.url.searchParams.get('cursor') ?? '';
const feed = mode === 'creator' ? await fetchFeed(Astro.request, cursor) : null;
const mine = mode === 'business' ? await fetchMyTasks(Astro.request) : null;
const active = (mine ?? []).filter((t) => t.status === 'pending_review' || t.status === 'published');
const drafts = (mine ?? []).filter((t) => t.status === 'draft' || t.status === 'rejected').length;
const failed = (mode === 'creator' && !feed) || (mode === 'business' && !mine);
---
<App title="Лента" page="feed">
  <Nudge me={me} />

  {mode === 'creator' ? (
    <section aria-labelledby="feed-t">
      <div class="head"><h1 id="feed-t">Задания</h1></div>
      {failed ? (
        <div class="empty"><Icon name="circle-alert" size={32} /><h2>Лента не загрузилась</h2><p>Обновите страницу через минуту.</p></div>
      ) : feed!.tasks.length === 0 ? (
        <div class="empty" data-empty>
          <Icon name="inbox" size={32} />
          <h2>Заданий пока нет</h2>
          <p>Появятся, как только бизнес их опубликует.</p>
          <a class="btn pill-dark" href="/app/card"><Icon name="id-card" size={20} />Заполнить анкету</a>
        </div>
      ) : (
        <>
          <div class="list" data-feed>{feed!.tasks.map((t) => <TaskItem task={t} />)}</div>
          {feed!.next && <div class="more"><a class="btn pill-ghost" href={`/app?cursor=${encodeURIComponent(feed!.next)}`}>Показать ещё</a></div>}
        </>
      )}
    </section>
  ) : (
    <section aria-labelledby="feed-t">
      <div class="head">
        <h1 id="feed-t">Ваши задания</h1>
        {active.length > 0 && <a class="btn pill-emerald" href="/app/tasks/new"><Icon name="plus" size={20} />Создать</a>}
      </div>
      {drafts > 0 && (
        <div class="nudge line-gap"><a href="/app/tasks?status=draft"><span>Черновики: {drafts}</span><b>Открыть<Icon name="arrow-right" size={16} /></b></a></div>
      )}
      {failed ? (
        <div class="empty"><Icon name="circle-alert" size={32} /><h2>Не загрузилось</h2><p>Обновите страницу через минуту.</p></div>
      ) : active.length === 0 ? (
        <div class="empty" data-empty>
          <Icon name="square-plus" size={32} />
          <h2>Создайте первое задание</h2>
          <p>Что снять, где и за сколько — оплата за результат.</p>
          <a class="btn pill-emerald" href="/app/tasks/new" data-create-task><Icon name="plus" size={20} />Создать задание</a>
        </div>
      ) : (
        <div class="list">{active.map((t) => <TaskItem task={t} own />)}</div>
      )}
    </section>
  )}
</App>
<script>
  // «Подробнее» в ленте — раскрыть блоки и фото задания
  document.querySelectorAll<HTMLButtonElement>('[data-expand]').forEach((b) =>
    b.addEventListener('click', () => {
      const box = document.getElementById(b.getAttribute('aria-controls')!)!;
      const open = b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', String(open));
      box.hidden = !open;
      b.firstChild!.textContent = open ? 'Свернуть' : 'Подробнее';
    }),
  );
</script>
