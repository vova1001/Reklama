---
// Страница задания из ленты: полностью расписанный кейс и «Откликнуться» (пока без сделок — сообщение).
import App from '../../../layouts/App.astro';
import Icon from '../../../components/Icon.astro';
import TaskPage from '../../../components/app/TaskPage.astro';
import Complain from '../../../components/app/Complain.astro';
import { fetchPublicTask } from '../../../lib/auth';

const me = Astro.locals.me;
if (!me) return Astro.redirect('/login', 303);
const id = Number(Astro.params.id);
const task = Number.isSafeInteger(id) && id > 0 ? await fetchPublicTask(Astro.request, id) : null;
if (!task) Astro.response.status = 404;
---
<App title={task?.title || 'Задание'} page="feed">
  <a class="btn pill-text back-lnk" href="/app"><Icon name="arrow-left" size={18} />Лента</a>
  {!task ? (
    <div class="empty"><Icon name="inbox" size={32} /><h2>Задание не найдено</h2><p>Возможно, его сняли с публикации.</p><a class="btn pill-ghost" href="/app">В ленту</a></div>
  ) : (
    <TaskPage task={task}>
      <div class="cta">
        <button class="btn pill-emerald" type="button" data-soon="Отклики появятся в ближайшем обновлении"><Icon name="send" size={18} />Откликнуться</button>
      </div>
      <Complain subject="task" id={task.id} />
    </TaskPage>
  )}
</App>
<script>
  import { toast } from '../../../lib/ui';
  document.querySelector<HTMLButtonElement>('[data-soon]')?.addEventListener('click', (e) => toast((e.currentTarget as HTMLElement).dataset.soon!));
</script>
