---
// Редактор задания и анкеты: та же оболочка приложения (навигация слева, на телефоне — снизу), над колонкой —
// тонкая панель формы (✕, «Правка / Как увидят», сохранение, «Осталось…», «Опубликовать»), колонка шире обычной.
import App from './App.astro';
import type { Page } from '../content/app';
import type { Mode } from '../lib/auth';

interface Props { title: string; page: Page; only: Mode }
const { title, page, only } = Astro.props;
---
<App title={title} page={page} only={only} wide="editor">
  <slot />
</App>
