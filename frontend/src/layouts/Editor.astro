---
// Редактор на весь экран (создание и правка задания, анкета): без навигации приложения — сверху тонкая панель
// формы (✕, «Правка / Как увидят», сохранение, «Опубликовать»), по центру — одна широкая колонка.
import Base from './Base.astro';
import Overlays from '../components/app/Overlays.astro';
import type { Mode } from '../lib/auth';
import '../styles/auth.css';
import '../styles/app.css';

interface Props { title: string; only: Mode }
const { title, only } = Astro.props;
const me = Astro.locals.me!;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<Base title={`${title} — Охват`} description="Редактор Охвата." noindex theme="#FFFFFF" bodyClass="app-body">
  <div class="app ed-app" data-app data-mode={me.user.mode} data-page="editor" data-page-mode={only}>
    <a class="skip" href="#main">К содержимому</a>
    <slot />
    <Overlays />
  </div>
</Base>
