---
// Приложение после входа. Всё служебное — слева: знак, навигация, режим «Бизнес / Автор», аватар с меню.
// Справа — только содержимое одной колонкой (~600px). Телефон: сверху знак, режим и аватар; внизу — навигация.
// Режим переключается без перезагрузки: элементы с data-for-mode видны по data-mode корня (scripts/app.ts).
import Base from './Base.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import Nav from '../components/app/Nav.astro';
import ModeSwitch from '../components/app/ModeSwitch.astro';
import AccountMenu from '../components/app/AccountMenu.astro';
import BottomNav from '../components/app/BottomNav.astro';
import type { Page } from '../content/app';
import type { Mode } from '../lib/auth';
import '../styles/auth.css';
import '../styles/app.css';

// only — страница одного режима (редактор задания — бизнес, анкета — автор): при смене режима — в ленту
interface Props { title: string; page: Page; wide?: boolean; only?: Mode }
const { title, page, wide = false, only } = Astro.props;
const me = Astro.locals.me!;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<Base title={`${title} — Охват`} description="Приложение Охвата: задания, анкеты и профиль." noindex theme="#FFFFFF" bodyClass="app-body">
  <div class="app" data-app data-mode={me.user.mode} data-page={page} data-page-mode={only}
    data-business-filled={String(me.profiles.business)} data-creator-filled={String(me.profiles.creator)}>
    <a class="skip" href="#main">К содержимому</a>

    <aside class="rail" aria-label="Навигация">
      <a class="rail-logo" href="/app" aria-label="Охват — лента"><Mark size={30} /><b>Охват</b></a>
      <nav class="rail-nav" aria-label="Разделы"><Nav page={page} variant="rail" /></nav>
      <ModeSwitch mode={me.user.mode} id="mode-rail" class="rail-mode" />
      <AccountMenu me={me} id="menu-rail" up />
    </aside>

    <header class="mbar">
      <a class="rail-logo" href="/app" aria-label="Охват — лента"><Mark size={30} /></a>
      <ModeSwitch mode={me.user.mode} id="mode-bar" />
      <AccountMenu me={me} id="menu-bar" />
    </header>

    <main id="main" class={`col ${wide ? 'is-wide' : ''}`} tabindex="-1">
      <slot />
    </main>

    <BottomNav page={page} />

    <!-- подтверждение (свой диалог вместо confirm) -->
    <dialog class="dlg" data-confirm aria-labelledby="dlg-t" aria-describedby="dlg-s">
      <form method="dialog" class="dlg-card">
        <h2 id="dlg-t" data-confirm-title>Подтвердите</h2>
        <p id="dlg-s" data-confirm-text></p>
        <div class="dlg-act">
          <button class="btn pill-ghost" value="cancel" type="submit">Отмена</button>
          <button class="btn pill-danger" value="ok" type="submit" data-confirm-ok>Да</button>
        </div>
      </form>
    </dialog>
    <div class="toast" role="status" aria-live="polite" data-toast><span data-toast-text></span><button type="button" class="toast-act" hidden data-toast-act><Icon name="undo-2" size={16} /><span>Вернуть</span></button></div>
  </div>
</Base>
<script src="../scripts/app.ts"></script>
