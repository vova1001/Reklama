---
import '../styles/global.css';
interface Props { title: string; description: string; noindex?: boolean; theme?: string; bodyClass?: string }
const { title, description, noindex = false, theme = '#1B1B1A', bodyClass } = Astro.props;
const site = process.env.PUBLIC_URL ?? 'http://localhost:8000';
const url = new URL(Astro.url.pathname, site).toString();
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Inter-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Охват" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL('/og.png', site).toString()} />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class={bodyClass}>
    <slot />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
