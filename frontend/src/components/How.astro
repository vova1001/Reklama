---
import Icon from './Icon.astro';
import Head from './Head.astro';
import { STEPS } from '../content/home';
---
<div class="blk how" id="business">
  <Head title="Как это работает<br>для бизнеса" lead="Четыре шага — от тарифа до оплаты." />
  <ol class="steps g12">
    {STEPS.map((s, n) => (
      <li class="st cd" data-reveal style={`--i:${n}`}>
        <div class="top">
          <i class="ring"><Icon name={s.icon} size={26} /></i>
          {n < STEPS.length - 1 && <span class="nx"><Icon name="arrow-right" size={24} /></span>}
        </div>
        <h3>{s.title}</h3>
        <p set:html={s.text} />
        <div class="chips">
          {s.chips
            ? s.chips.map((c) => <span class="chip">{c}</span>)
            : <span class="chip chip-ok"><Icon name="check" size={20} />Оплачено автору</span>}
        </div>
      </li>
    ))}
  </ol>
</div>
