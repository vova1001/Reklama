---
import Icon from './Icon.astro';
import Head from './Head.astro';
import { STEPS } from '../content/home';
---
<div class="blk how">
  <Head level={3} title="Как это работает" />
  <ol class="steps g12">
    {STEPS.map((s, n) => (
      <li class="st cd" data-reveal style={`--i:${n}`}>
        <div class="top">
          <i class="ring"><Icon name={s.icon} size={26} /></i>
          <span class="num" aria-hidden="true">0{n + 1}</span>
        </div>
        <h4>{s.title}</h4>
        <p set:html={s.text} />
      </li>
    ))}
  </ol>
</div>
