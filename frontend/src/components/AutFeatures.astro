---
// Возможности для авторов: ровный список с разделителями (название + тариф справа) и превью выделенного профиля в каталоге.
import Icon from './Icon.astro';
import Head from './Head.astro';
import { AUT, CATALOG } from '../content/home';
---
<div class="blk aut-feat">
  <Head level={3} title="Возможности для авторов" />
  <div class="af g12">
    <ul class="af-list">
      {AUT.features.map((f, i) => (
        <li data-reveal style={`--i:${i}`}>
          <i class="ring"><Icon name={f.icon} size={22} /></i>
          <h4>{f.title}</h4>
          <span class="ptag">{f.tag}</span>
        </li>
      ))}
    </ul>
    <div class="cat-pv" data-reveal aria-hidden="true">
      <div class="feed-h"><span>Каталог авторов</span><span>Казань</span></div>
      {CATALOG.map((c, i) => (
        <div class:list={['pf', { hot: i === 0 }]}>
          {i === 0 && <div class="pf-cover"></div>}
          {i === 0
            ? <img src="/img/creator-avatar-144.webp" width="144" height="144" alt="" loading="lazy" decoding="async" />
            : <span class="av">{c.name[0]}</span>}
          <div class="pf-t">
            <b>{c.name}{i === 0 && <em class="pro"><Icon name="badge-check" size={16} />Про</em>}</b>
            <span>{c.city} · {c.topics.join(', ')}</span>
          </div>
          <div class="pf-r">
            {i === 0 && <em class="intop"><Icon name="trending-up" size={16} />В топе</em>}
            <span>{c.done}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
