---
// Как это работает для автора: фото с параллаксом и уведомлением об оплате + шаги, связанные прорисовываемой линией.
import Icon from './Icon.astro';
import Head from './Head.astro';
import { AUT } from '../content/home';
---
<div class="blk aut-how">
  <Head level={3} title="Как это работает" lead="Три шага — и оплата приходит сама." />
  <div class="ah g12">
    <div class="ah-pic" data-reveal>
      <img src="/img/creator-1040.webp" srcset="/img/creator-560.webp 560w, /img/creator-1040.webp 1040w"
        sizes="(min-width: 1200px) 476px, (min-width: 1024px) 40vw, 100vw" width="1040" height="1160" alt="" loading="lazy" decoding="async" data-px />
      <div class="paid" aria-hidden="true">
        <i><Icon name="check" size={22} /></i>
        <div><span>Оплата получена</span><b>+3&nbsp;000&nbsp;₽</b></div>
      </div>
    </div>
    <div class="vflow" data-flow data-progress="0.8,0.3">
      <div class="track" aria-hidden="true"><span class="fill"></span></div>
      <ol>
        {AUT.steps.map((s, i) => (
          <li class="node" data-node>
            <i class="ring">{i + 1}</i>
            <div><h4>{s.title}</h4><p>{s.text}</p></div>
          </li>
        ))}
        <li class="node fin" data-node>
          <i class="ring"><Icon name="wallet" size={24} /></i>
          <div><h4>Оплата</h4><p>Сразу после проверки — без напоминаний.</p></div>
        </li>
      </ol>
    </div>
  </div>
</div>
