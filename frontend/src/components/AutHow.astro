---
// Как это работает для автора: три шага в один ряд (на телефоне — столбиком), между кругами — отрезки линии.
import Icon from './Icon.astro';
import Head from './Head.astro';
import { AUT } from '../content/home';
---
<div class="blk aut-how">
  <Head level={3} title="Как это работает" />
  <div class="flow flow3" data-flow data-progress="0.85,0.5" style={`--n:${AUT.steps.length - 1}`}>
    <ol>
    {AUT.steps.map((s, i) => (
      <li class="node" data-node style={`--k:${i}`}>
        <i class="ring"><Icon name={s.icon} size={26} /></i>
        <div><h4><span class="sn">{i + 1}</span>{s.title}</h4><p>{s.text}</p></div>
        {i < AUT.steps.length - 1 && <span class="seg" aria-hidden="true"><span></span></span>}
      </li>
    ))}
    </ol>
  </div>
</div>
