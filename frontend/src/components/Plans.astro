---
import Icon from './Icon.astro';
import type { Plan } from '../lib/api';
interface Props { plans: Plan[]; dark?: boolean }
const { plans, dark = false } = Astro.props;
// кнопки: на светлом — тёмная (выделенный — светлая), на тёмном — контурная (выделенный — тёмная)
const btn = (hot: boolean) => (dark ? (hot ? 'b-d' : 'b-ol') : hot ? 'b-l' : 'b-d');
---
<div class="plans g12">
  {plans.map((p, i) => (
    <div class:list={['cd plan', { 'plan-on': p.recommended }]} data-reveal style={`--i:${i}`}>
      <div class="pl-h"><h4>{p.name}</h4>{p.recommended && <span class="rec">Рекомендуем</span>}</div>
      <p class="pl-s">{p.subtitle}</p>
      <div class="price">{p.priceText}<small>/&nbsp;мес</small></div>
      <ul>{p.features.map((f) => <li><Icon name="check" size={22} /><span>{f}</span></li>)}</ul>
      <a class:list={['btn', btn(p.recommended)]} href={`/pricing?for=${p.audience}&plan=${p.slug}`}>{p.cta}</a>
    </div>
  ))}
</div>
