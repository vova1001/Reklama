---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Avatar from './Avatar.astro';
import { NAV } from '../content/home';
import { shortName } from '../lib/auth';
const me = Astro.locals.me;
---
<!-- Шапка: во всю ширину на первом экране; при прокрутке сворачивается в стеклянную «пилюлю» по центру.
     Вошёл — вместо «Войти» аватар и имя (ссылка в кабинет). -->
<header class="bar" data-bar>
  <div class="shell">
    <Logo />
    <ul>{NAV.map((n) => <li><a class="lnk" href={n.href}>{n.title}</a></li>)}</ul>
    <div class="r">
      {me ? (
        <a class="me-link" href="/account" aria-label={`Кабинет: ${me.user.name || 'профиль'}`} data-me>
          <Avatar user={me.user} size={36} /><span class="nm">{shortName(me.user)}</span>
        </a>
      ) : (
        <a class="login lnk" href="/login">Войти</a>
      )}
      <a class="btn b-l" href="/tasks/new">Разместить задание</a>
      <button class="burger ring" type="button" aria-label="Меню" aria-expanded="false" aria-controls="menu" data-burger>
        <Icon name="menu" size={22} class="ic-menu" /><Icon name="x" size={22} class="ic-x" />
      </button>
    </div>
  </div>
</header>
<nav class="menu" id="menu" aria-label="Меню" data-menu>
  <div class="w">
    <ul>
      {NAV.map((n) => <li><a href={n.href}>{n.title}</a></li>)}
      <li>{me ? <a href="/account">Кабинет</a> : <a href="/login">Войти</a>}</li>
    </ul>
    <div class="cta"><a class="btn b-l" href="/tasks/new">Разместить задание</a><a class="btn b-ol" href="/tasks">Найти заказы</a></div>
  </div>
</nav>
