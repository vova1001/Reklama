---
// Верхняя панель приложения: знак → лента, переключатель режима, поиск (пока заглушка), аватар с меню.
import Mark from '../Mark.astro';
import Icon from '../Icon.astro';
import Avatar from '../Avatar.astro';
import ModeSwitch from './ModeSwitch.astro';
import Search from './Search.astro';
import { MODES } from '../../content/app';
import type { Me } from '../../lib/auth';
interface Props { me: Me }
const { me } = Astro.props;
const u = me.user;
---
<header class="ab">
  <div class="ab-in">
    <a class="ab-logo" href="/app" aria-label="Охват — лента"><Mark size={34} /><b>Охват</b></a>
    <ModeSwitch mode={u.mode} id="mode-bar" />
    <Search id="q-bar" class="ab-search" />
    <div class="ab-r">
      <button class="ab-ava" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="me-menu" aria-label="Меню профиля" data-menu-btn>
        <Avatar user={u} size={40} />
        <Icon name="chevron-down" size={16} class="ab-chev" />
      </button>
      <div class="mm" id="me-menu" role="menu" aria-label="Профиль" hidden data-menu>
        <div class="mm-head" role="none">
          <Avatar user={u} size={44} />
          <div role="none">
            <p class="mm-name">{u.name || 'Без имени'}</p>
            <p class="mm-mail">{u.email ?? 'Почта не указана'}</p>
          </div>
        </div>
        <a class="mm-it" role="menuitem" href="/app/profile" tabindex="-1"><Icon name="user-round" size={20} />Профиль</a>
        <p class="mm-lbl" role="none" id="mm-mode">Режим</p>
        <div role="group" aria-labelledby="mm-mode">
          {MODES.map((m) => (
            <button class="mm-it" type="button" role="menuitemradio" tabindex="-1" aria-checked={u.mode === m.id ? 'true' : 'false'} data-set-mode={m.id}>
              <Icon name={m.icon} size={20} />{m.title}<span class="mm-dot" aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <a class="mm-it" role="menuitem" href="/app/settings" tabindex="-1"><Icon name="key-round" size={20} />Настройки входа</a>
        <hr class="mm-sep" />
        <button class="mm-it mm-out" type="button" role="menuitem" tabindex="-1" data-logout><Icon name="log-out" size={20} />Выйти</button>
      </div>
    </div>
  </div>
</header>
