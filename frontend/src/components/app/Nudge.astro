---
// Тонкая строка вверху ленты: профиль режима не заполнен. Закрывается (запоминается до конца сеанса).
import Icon from '../Icon.astro';
import { NUDGE } from '../../content/app';
import type { Me, Mode } from '../../lib/auth';
interface Props { me: Me }
const { me } = Astro.props;
const modes: Mode[] = ['business', 'creator'];
---
{modes.map((m) => (
  <div class="nudge" data-for-mode={m} data-nudge={m} hidden={me.profiles[m]} role="note">
    <a href={`/app/profile?tab=${m}`}><span>{NUDGE[m]}</span><b>Заполнить<Icon name="arrow-right" size={16} /></b></a>
    <button class="nudge-x" type="button" aria-label="Скрыть" data-nudge-close><Icon name="x" size={16} /></button>
  </div>
))}
