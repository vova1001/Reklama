---
// Своё задание строкой («Мои»): кто и где, название (ссылка), обложка, факты, статус, причина отказа.
import Icon from '../Icon.astro';
import { STATUS } from '../../content/app';
import { formatsTitle, goal, rub, until } from '../../lib/format';
import type { Task } from '../../lib/auth';
interface Props { task: Task; own?: boolean; brand?: string }
const { task: t, own = false, brand } = Astro.props;
const href = own ? `/app/tasks/${t.id}` : '';
const where = t.nationwide ? 'Вся Россия' : t.city;
---
<article class="it" id={`task-${t.id}`} data-status={t.status}>
  <div class="it-meta">
    <span>{brand ?? t.brand ? <b>{brand ?? t.brand}</b> : null}{(brand ?? t.brand) && where ? ' · ' : ''}{where}{t.categoryTitle ? ` · ${t.categoryTitle}` : ''}</span>
    {own && <span class="st" data-s={t.status}>{STATUS[t.status]}</span>}
  </div>
  <h2 class="it-t">{href ? <a href={href}>{t.title || 'Без названия'}</a> : t.title}</h2>
  {t.cover && <img class="it-cover" src={t.cover.src} srcset={`${t.cover.thumb} 320w, ${t.cover.src} 800w, ${t.cover.large} 1600w`} sizes="(min-width: 768px) 600px, 100vw" alt="" loading="lazy" decoding="async" width="800" height="450" />}
  <div class="facts">
    {t.rewardKopecks > 0 && <span><Icon name="wallet" size={18} /><b>{rub(t.rewardKopecks)}</b></span>}
    {goal(t.minViews) && <span><Icon name="eye" size={18} />{goal(t.minViews)}</span>}
    {t.formats.length > 0 && <span><Icon name="video" size={18} />{formatsTitle(t.formats)}</span>}
    {t.publishBy && <span><Icon name="calendar" size={18} />{until(t.publishBy, t.publishTime)}</span>}
  </div>
  {own && t.status === 'rejected' && t.rejectReason && <p class="it-reason">{t.rejectReason}</p>}
  <slot />
</article>
