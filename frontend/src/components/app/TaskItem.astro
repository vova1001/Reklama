---
import { STATUS } from '../../content/app';
import { formatsTitle, goal, rub, until } from '../../lib/format';
import type { Task } from '../../lib/auth';
interface Props { task: Task; own?: boolean; brand?: string }
const { task: t, own = false, brand } = Astro.props;
const href = own ? `/app/tasks/${t.id}` : '';
const where = t.nationwide ? 'Вся Россия' : t.city;
const target = goal(t.minViews, t.goal);
const metadata = [
  ['Город', where || 'Не указано'],
  ['Форматы', t.formats.length ? formatsTitle(t.formats) : 'Не указано'],
  ['Цель', `${target || 'Не указано'}${(t.goals?.length ?? 0) > 1 ? ` · ещё ${t.goals.length - 1}` : ''}`],
  ['Оплата', t.rewardKopecks > 0 ? rub(t.rewardKopecks) : 'Не указано'],
  ['Срок', t.publishBy ? until(t.publishBy, t.publishTime) || 'Не указано' : 'Не указано'],
];
---
<article class="it" id={`task-${t.id}`} data-status={t.status}>
  <div class="it-media">
    {t.cover ? <img class="it-cover" src={t.cover.src} srcset={`${t.cover.thumb} 320w, ${t.cover.src} 800w, ${t.cover.large} 1600w`} sizes="240px" alt="" loading="lazy" decoding="async" width="800" height="450" /> : <span class="it-placeholder">Без обложки</span>}
  </div>
  <div class="it-body">
    <div class="it-head">
      <div class="it-heading">
        {(brand ?? t.brand) && <p class="it-brand">{brand ?? t.brand}</p>}
        <h2 class="it-t">{href ? <a href={href}>{t.title || 'Без названия'}</a> : t.title || 'Без названия'}</h2>
      </div>
      {own && <span class="task-status" data-s={t.status}>{STATUS[t.status]}</span>}
    </div>
    <dl class="it-facts">
      {metadata.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
    </dl>
    {own && t.status === 'rejected' && t.rejectReason && <p class="it-reason">{t.rejectReason}</p>}
    <slot />
  </div>
</article>
