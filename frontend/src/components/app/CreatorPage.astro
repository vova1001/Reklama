---
// Анкета автора целиком: фото, имя, город, темы, подтверждённые соцсети (цифры — от площадки, дата обновления),
// блоки, работы. Слот — действие внизу.
import Icon from '../Icon.astro';
import TaskBody from './TaskBody.astro';
import { PLATFORM_TITLE } from '../../content/app';
import { socialFacts } from '../../lib/format';
import type { Card } from '../../lib/auth';
interface Props { card: Card; topics: string[] }
const { card: c, topics } = Astro.props;
---
<article class="page" data-card-page={c.id} data-lb-group>
  <div class="pv-who">
    {c.avatar ? <img class="pv-ava page-ava" src={c.avatar.src} alt="" width="96" height="96" /> : <span class="pv-ava page-ava"></span>}
    <div>
      <h1 class="page-t">{c.name}</h1>
      <p class="page-meta">{c.city}{c.pageSlug && <>{c.city && ' · '}<a class="brand-lnk" href={`/c/${c.pageSlug}`} data-profile-link>Профиль автора</a></>}</p>
    </div>
  </div>
  {topics.length > 0 && <div class="chips pv-tags">{topics.map((t) => <span class="chip is-static">{t}</span>)}</div>}
  <ul class="rows">
    {c.platforms.map((p) => (
      <li data-platform={p.kind}>
        <Icon name="badge-check" size={20} class="ic-ok" />
        <div>
          <p class="row-t">{PLATFORM_TITLE[p.kind] ?? p.kind} · {p.url ? <a href={p.url} target="_blank" rel="noopener nofollow ugc">{p.title || `@${p.handle}`}</a> : p.title}</p>
          <p class="row-s"><span class="soc-badge">Подтверждено</span> {socialFacts(p)}</p>
        </div>
        <span class="row-v">{p.followersHidden ? 'скрыто' : `${p.followers.toLocaleString('ru-RU')}`}</span>
      </li>
    ))}
  </ul>
  <TaskBody blocks={c.blocks} photos={c.works} />
  <slot />
</article>
