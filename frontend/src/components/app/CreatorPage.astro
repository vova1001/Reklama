---
// Анкета автора целиком: фото, имя, город, темы, площадки с подписчиками, блоки, работы. Слот — действие внизу.
import Icon from '../Icon.astro';
import TaskBody from './TaskBody.astro';
import { PLATFORM_TITLE } from '../../content/app';
import { num } from '../../lib/format';
import type { Card } from '../../lib/auth';
interface Props { card: Card; topics: string[] }
const { card: c, topics } = Astro.props;
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
---
<article class="page" data-card-page={c.id}>
  <div class="pv-who">
    {c.avatar ? <img class="pv-ava page-ava" src={c.avatar.src} alt="" width="96" height="96" /> : <span class="pv-ava page-ava"></span>}
    <div><h1 class="page-t">{c.name}</h1><p class="page-meta">{c.city}</p></div>
  </div>
  {topics.length > 0 && <div class="chips pv-tags">{topics.map((t) => <span class="chip is-static">{t}</span>)}</div>}
  <ul class="rows">
    {c.platforms.map((p) => (
      <li><Icon name="link" size={20} /><div><p class="row-t">{PLATFORM_TITLE[p.kind] ?? 'Сайт'}</p><a class="row-s" href={p.url} target="_blank" rel="noopener nofollow ugc">{host(p.url)}</a></div><span class="row-v">{num(p.followers)} подписч.</span></li>
    ))}
  </ul>
  <TaskBody blocks={c.blocks} photos={c.works} />
  <slot />
</article>
