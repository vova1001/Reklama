---
// Поиск по заданиям и авторам — пока заглушка: поле есть, по Enter — сообщение «скоро».
import Icon from '../Icon.astro';
interface Props { id: string; class?: string }
const { id, class: cls = '' } = Astro.props;
---
<form class={`srch ${cls}`} role="search" novalidate data-search>
  <label class="sr-only" for={id}>Поиск</label>
  <Icon name="search" size={20} />
  <input class="srch-in" id={id} name="q" type="search" autocomplete="off" maxlength="100" placeholder="Задания, авторы, темы" />
</form>
