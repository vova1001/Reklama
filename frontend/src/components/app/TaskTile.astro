---
import { formatsTitle, goal, rub, until } from '../../lib/format';
import type { Task } from '../../lib/auth';
interface Props { task: Task }
const { task: t } = Astro.props;
const where = t.nationwide ? 'Вся Россия' : t.city;
const target = goal(t.minViews, t.goal);
const metadata = [
  ['Город', where || 'Не указано'],
  ['Форматы', t.formats.length ? formatsTitle(t.formats) : 'Не указано'],
  ['Цель', `${target || 'Не указано'}${(t.goals?.length ?? 0) > 1 ? ` · ещё ${t.goals.length - 1}` : ''}`],
  ['Оплата', t.rewardKopecks > 0 ? rub(t.rewardKopecks) : 'Не указано'],
  ['Срок', t.publishBy ? until(t.publishBy, t.publishTime) || 'Не указано' : 'Не указано'],
];
---
<li class="tile" data-tile={t.id}>
  <a class="tile-a" href={`/app/task/${t.id}`}>
    <div class="tile-ph">
      {t.cover ? <img src={t.cover.thumb} srcset={`${t.cover.thumb} 320w, ${t.cover.src} 800w`} sizes="(min-width: 1200px) 320px, 100vw" alt="" loading="lazy" decoding="async" width="800" height="450" /> : <span class="tile-none">Без обложки</span>}
    </div>
    <div class="tile-body">
      <h2 class="tile-t">{t.title || 'Без названия'}</h2>
      <dl class="tile-facts">
        {metadata.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
    </div>
  </a>
  {t.brandSlug && t.brand && <a class="tile-who" href={`/b/${t.brandSlug}`} data-brand-link>{t.brand}</a>}
</li>
