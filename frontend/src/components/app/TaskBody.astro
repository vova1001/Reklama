---
// Содержимое задания или анкеты: блоки (абзацы, пункты, ссылки) и фото — так, как увидят другие. Фото открываются
// поверх страницы (scripts/lightbox.ts): листание, счётчик, миниатюры; без новых вкладок.
import type { components } from '../../lib/api.gen';
type Block = components['schemas']['Block'];
type Photo = components['schemas']['Photo'];
interface Props { blocks: Block[]; photos?: Photo[] }
const { blocks, photos = [] } = Astro.props;
---
<div class="body">
  {blocks.filter((b) => b.items.length).map((b) => (
    <section class="body-b">
      {b.title && <h3>{b.title}</h3>}
      {b.kind === 'text' ? b.items.map((p) => <p>{p}</p>) : (
        <ul class={`k-${b.kind}`}>
          {b.items.map((i) => <li>{b.kind === 'links' ? <a href={i} rel="nofollow noopener noreferrer ugc" target="_blank">{i.replace(/^https:\/\//, '')}</a> : i}</li>)}
        </ul>
      )}
    </section>
  ))}
  {photos.length > 0 && (
    <div class="body-ph">
      {photos.map((p, i) => (
        <button type="button" class="lb-t" data-lb data-src={p.src} data-large={p.large} data-thumb={p.thumb} aria-label={`Открыть фото ${i + 1} из ${photos.length}`}>
          <img src={p.thumb} srcset={`${p.thumb} 320w, ${p.src} 800w`} sizes="200px" alt="" loading="lazy" decoding="async" width="320" height="320" />
        </button>
      ))}
    </div>
  )}
</div>
<script src="../../scripts/lightbox.ts"></script>
