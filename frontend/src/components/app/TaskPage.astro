---
// Задание целиком (страница задания и своё на проверке): обложка, кто и где, название, условия, блоки, фото.
// Слот — действие внизу (например, «Откликнуться»).
import Icon from '../Icon.astro';
import TaskBody from './TaskBody.astro';
import { formatsTitle, goal, rub, until } from '../../lib/format';
import type { Task } from '../../lib/auth';
interface Props { task: Task }
const { task: t } = Astro.props;
const where = t.nationwide ? 'Вся Россия' : t.city;
const meta = [t.brand, where, (t.categoryTitles ?? []).join(', ')].filter(Boolean).join(' · ');
const g = goal(t.minViews);
---
<article class="page" data-task-page={t.id} data-lb-group>
  {t.cover && (
    <button type="button" class="lb-t page-cover-b" data-lb data-src={t.cover.src} data-large={t.cover.large} data-thumb={t.cover.thumb} aria-label="Открыть обложку">
      <img class="page-cover" src={t.cover.src} srcset={`${t.cover.src} 800w, ${t.cover.large} 1600w`} sizes="(min-width: 768px) 720px, 100vw" alt="" width="800" height="450" decoding="async" />
    </button>
  )}
  {meta && <p class="page-meta">{meta}</p>}
  <h1 class="page-t">{t.title || 'Без названия'}</h1>
  <dl class="terms">
    {t.rewardKopecks > 0 && <div><dt><Icon name="wallet" size={18} />Оплата</dt><dd><b>{rub(t.rewardKopecks)}</b> за выполнение</dd></div>}
    {g && <div><dt><Icon name="eye" size={18} />Условия</dt><dd>{g}</dd></div>}
    {t.formats.length > 0 && <div><dt><Icon name="video" size={18} />Формат</dt><dd>{formatsTitle(t.formats)}</dd></div>}
    {t.publishBy && <div><dt><Icon name="calendar" size={18} />Срок</dt><dd>{until(t.publishBy, t.publishTime)}</dd></div>}
    <div><dt><Icon name={t.access === 'approval' ? 'user-round-check' : 'zap'} size={18} />Кто берёт</dt><dd>{t.access === 'approval' ? 'С одобрением бизнеса' : 'Любой автор'}</dd></div>
  </dl>
  <TaskBody blocks={t.blocks} photos={t.photos} />
  <slot />
</article>
