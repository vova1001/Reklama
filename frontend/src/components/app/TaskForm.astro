---
// Задание на весь экран: обложка и название крупно, затем разделы с заголовком и подсказкой в одну строку —
// «Основное» (сферы, город, форматы), «Условия» (кто берёт, просмотры, оплата, срок), «Описание» (блоки, шаблоны
// одним нажатием), «Фото». Сферы и форматы — несколько, с «+ Своя / + Свой»; срок — пилюлями или «+ Свой»
// (календарь и время). Логика — scripts/editor.ts.
import Icon from '../Icon.astro';
import EditorBar from './EditorBar.astro';
import { FORM_GROUPS, TASK_BLOCKS, TASK_TEMPLATES } from '../../content/app';
import type { CategoryItem, Task } from '../../lib/auth';
interface Props { task: Task | null; categories: { common: CategoryItem[]; own: CategoryItem[] }; brand: string }
const { task: t, categories, brand } = Astro.props;
const init = {
  kind: 'task', id: t?.id ?? null, status: t?.status ?? 'draft', blocks: t ? t.blocks : TASK_BLOCKS, templates: TASK_TEMPLATES,
  cover: t?.cover ? [t.cover] : [], photos: t?.photos ?? [], selected: t?.categories ?? [], formats: t?.formats ?? [],
  categories, brand, uid: Astro.locals.me!.user.id, updatedAt: t?.updatedAt ?? null,
};
const json = JSON.stringify(init).replace(/</g, '\\u003c');
const due = t?.publishBy ? t.publishBy.split('-').reverse().join('.') : '';
const rub = t && t.rewardKopecks ? String(Math.round(t.rewardKopecks / 100)) : '';
const views = t && t.minViews ? String(t.minViews) : '';
const access = t?.access ?? 'open';
const G = FORM_GROUPS.task;
---
<form class="ed" novalidate autocomplete="off" data-editor="task">
  <script type="application/json" data-init set:html={json} />
  <EditorBar close="/app/tasks" state={t ? 'Черновик' : 'Сохранится само'} />

  <div class="ed-col">
    {t?.status === 'rejected' && <p class="banner is-err" role="note"><Icon name="circle-alert" size={20} /><span><b>Отклонено.</b> {t.rejectReason}</span></p>}

    <div data-pane="edit">
      <div class="sec ed-cover">
        <div data-cover></div>
        <p class="ferr" data-err="cover"></p>
      </div>

      <div class="sec field ed-name" data-sec="title">
        <div class="cnt-w"><input class="inp ed-title" id="t-title" name="title" maxlength="100" value={t?.title ?? ''} placeholder="Название задания" aria-label="Название задания" data-input="title" data-count /><span class="cnt" data-count-for="title"></span></div>
        <p class="ferr" data-err="title"></p>
      </div>

      <section class="grp" aria-labelledby="g-main" aria-describedby="g-main-d">
        <h2 class="grp-h" id="g-main">{G.main.title}</h2>
        <p class="grp-d" id="g-main-d">{G.main.hint}</p>

        <div class="sec" data-sec="categories">
          <span class="lbl" id="cat-l">Сфера <span class="hint">· можно несколько, до 5</span></span>
          <div data-cats data-input="categories"></div>
          <p class="ferr" data-err="categories"></p>
        </div>

        <div class="sec field" data-sec="city">
          <label class="lbl" for="t-city">Город</label>
          <div class="city">
            <input class="inp" id="t-city" name="city" maxlength="80" value={t?.city ?? ''} placeholder="Казань" data-ph="Казань" autocomplete="address-level2" data-input="city" />
            <button class="sw" type="button" role="switch" aria-checked={t?.nationwide ? 'true' : 'false'} data-nationwide><span class="sw-k" aria-hidden="true"></span>Вся Россия</button>
          </div>
          <p class="ferr" data-err="city"></p>
        </div>

        <div class="sec" data-sec="formats">
          <span class="lbl" id="fmt-l">Формат <span class="hint">· можно несколько, до 3</span></span>
          <div data-formats data-input="formats"></div>
          <p class="ferr" data-err="formats"></p>
        </div>
      </section>

      <section class="grp" aria-labelledby="g-terms" aria-describedby="g-terms-d">
        <h2 class="grp-h" id="g-terms">{G.terms.title}</h2>
        <p class="grp-d" id="g-terms-d">{G.terms.hint}</p>

        <div class="sec">
          <span class="lbl" id="acc-l">Кто берёт</span>
          <div class="mseg" role="radiogroup" aria-labelledby="acc-l" data-access>
            <button type="button" role="radio" aria-checked={access === 'open' ? 'true' : 'false'} tabindex={access === 'open' ? 0 : -1} data-v="open"><Icon name="zap" size={18} />Любой автор</button>
            <button type="button" role="radio" aria-checked={access === 'approval' ? 'true' : 'false'} tabindex={access === 'approval' ? 0 : -1} data-v="approval"><Icon name="user-round-check" size={18} />С одобрением</button>
          </div>
        </div>

        <div class="sec row2">
          <div class="field" data-sec="minViews">
            <label class="lbl" for="t-views">Просмотры от</label>
            <div class="ifx"><Icon name="eye" size={20} /><input class="inp" id="t-views" name="minViews" inputmode="numeric" maxlength="13" value={views} placeholder="5 000" data-num data-input="minViews" /></div>
            <p class="ferr" data-err="minViews"></p>
          </div>
          <div class="field" data-sec="reward">
            <label class="lbl" for="t-reward">Оплата</label>
            <div class="ifx sfx"><Icon name="wallet" size={20} /><input class="inp" id="t-reward" name="reward" inputmode="numeric" maxlength="9" value={rub} placeholder="3 000" data-num data-input="reward" /><span class="sfx-t">₽</span></div>
            <p class="ferr" data-err="reward"></p>
          </div>
        </div>

        <div class="sec" data-sec="publishBy" data-due>
          <span class="lbl" id="due-l">Срок публикации</span>
          <div class="chips" role="group" aria-labelledby="due-l" data-input="publishBy">
            <button type="button" class="chip is-check" aria-pressed="false" data-days="3">3 дня</button>
            <button type="button" class="chip is-check" aria-pressed="false" data-days="7">Неделя</button>
            <button type="button" class="chip is-check" aria-pressed="false" data-days="14">2 недели</button>
            <button type="button" class="chip is-check" aria-pressed="false" data-days="30">Месяц</button>
            <button type="button" class="chip chip-add" aria-pressed="false" aria-expanded="false" aria-controls="due-panel" data-due-custom><Icon name="plus" size={18} />Свой</button>
          </div>
          <div class="due-p" id="due-panel" data-due-panel hidden>
            <div data-cal></div>
            <div class="due-t">
              <label class="lbl" for="t-time">Время <span class="hint">· по желанию, по Москве</span></label>
              <div class="ifx"><Icon name="clock" size={20} /><input class="inp" id="t-time" name="publishTime" inputmode="numeric" maxlength="5" value={t?.publishTime ?? ''} placeholder="чч:мм" /></div>
            </div>
            <p class="due-sum" data-due-sum aria-live="polite"></p>
          </div>
          <input type="hidden" name="publishBy" value={due} />
          <p class="ferr" data-err="publishBy"></p>
        </div>
      </section>

      <section class="grp" aria-labelledby="g-desc" aria-describedby="g-desc-d">
        <h2 class="grp-h" id="g-desc">{G.desc.title}</h2>
        <p class="grp-d" id="g-desc-d">{G.desc.hint}</p>
        <div class="sec" data-sec="blocks">
          <div data-blocks data-input="blocks"></div>
          <p class="ferr" data-err="blocks"></p>
        </div>
      </section>

      <section class="grp" aria-labelledby="g-photo" aria-describedby="g-photo-d">
        <h2 class="grp-h" id="g-photo">{G.photo.title}</h2>
        <p class="grp-d" id="g-photo-d">{G.photo.hint}</p>
        <div class="sec">
          <div data-photos></div>
          <p class="ferr" data-err="photos"></p>
        </div>
      </section>

      <div class="sec ed-danger" hidden={!t} data-delete-wrap><button class="btn pill-text" type="button" data-delete><Icon name="trash-2" size={18} />Удалить черновик</button></div>
    </div>

    <div data-pane="preview" hidden><div class="pv" data-preview></div></div>
  </div>
</form>
<script src="../../scripts/editor.ts"></script>
