# Свой сервер: https с автоматическим сертификатом Let's Encrypt для {$DOMAIN}. / → сайт, /api и /healthz → API.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	respond /ping "ok" 200
	@api path /api/* /healthz /media/*
	handle @api {
		# загрузка фото — до 10 МБ (бэкенд режет сам)
		request_body /api/me/media {
			max_size 11MB
		}
		# видео страниц — до VIDEO_MAX_MB (бэкенд режет сам)
		request_body /api/me/media/video {
			max_size 510MB
		}
		# адрес посетителя ставит только Caddy (присланный клиентом X-Real-IP перезаписывается)
		reverse_proxy backend:8080 {
			header_up X-Real-IP {remote_host}
		}
	}
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@static path /img/* /fonts/*
	header @static Cache-Control "public, max-age=2592000"
	handle {
		reverse_proxy frontend:4321
	}
}
