worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 512; }
http {
  include /etc/nginx/mime.types;
  access_log off;
  # адрес посетителя: Render стоит за Cloudflare, который ставит True-Client-IP; X-Forwarded-For подделывается клиентом
  # (если True-Client-IP нет — первый адрес X-Forwarded-For, иначе адрес соединения)
  map $http_x_forwarded_for $xff_first {
    "~^\s*([^,\s]+)" $1;
    default            $remote_addr;
  }
  map $http_true_client_ip $client_ip {
    ""      $xff_first;
    default $http_true_client_ip;
  }
  client_body_temp_path /tmp/nginx_body;
  proxy_temp_path /tmp/nginx_proxy;
  fastcgi_temp_path /tmp/nginx_fastcgi;
  uwsgi_temp_path /tmp/nginx_uwsgi;
  scgi_temp_path /tmp/nginx_scgi;
  server {
    listen ${PORT};
    server_tokens off;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;
    gzip_min_length 512;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location /api/      { proxy_pass http://127.0.0.1:8080; }
    # загрузка фото: до 10 МБ файла (бэкенд режет сам), без буфера на диск — сразу в бэкенд
    location = /api/me/media {
        client_max_body_size 11m;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        proxy_pass http://127.0.0.1:8080;
    }
    # видео страниц: до VIDEO_MAX_MB (бэкенд режет сам, здесь — с запасом), без буфера на диск, медленная связь
    location = /api/me/media/video {
        client_max_body_size 510m;
        proxy_request_buffering off;
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
        proxy_pass http://127.0.0.1:8080;
    }
    # фото: права и кэш решает бэкенд (Cache-Control, ETag)
    location /media/    { proxy_pass http://127.0.0.1:8080; }
    location = /healthz { proxy_pass http://127.0.0.1:8080; }
    location ~ ^/(img|fonts)/ {
      proxy_pass http://127.0.0.1:4321;
      proxy_hide_header Cache-Control;
      add_header Cache-Control "public, max-age=2592000" always;
    }
    location /_astro/ {
      proxy_pass http://127.0.0.1:4321;
      proxy_hide_header Cache-Control;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
    location / { proxy_pass http://127.0.0.1:4321; }
  }
}
