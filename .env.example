# «Охват» — все настройки только здесь (переменные окружения). Значения секретов в файлах не храним.
# Локально: make env создаст .env и придумает пароль базы. На Render — те же имена в render.yaml / Environment.
# Пусто — значение по умолчанию (указано в скобках).

# ===== режим =====
# production | development (development). В production коды из писем никогда не пишутся в журнал.
APP_ENV=development

# ===== база =====
# Пароль локальной базы docker compose (на своём сервере — обязательно свой).
POSTGRES_PASSWORD=
# Строка подключения — только на Render / внешней базе (локально её собирает docker-compose.yml).
# Neon: postgresql://…neon.tech/neondb?sslmode=require
# DATABASE_URL=

# ===== адрес сайта =====
# Единственный источник адреса: canonical, ссылки, redirect Google (${PUBLIC_URL}/api/auth/google/callback),
# флаг Secure у cookie (https → Secure). Без пути и «/» в конце. В production — только https.
PUBLIC_URL=http://localhost:8000
# Свой сервер (docker-compose.prod.yml): домен для Caddy и сертификата Let's Encrypt, например ohvat.ru
DOMAIN=
# Порт сайта на этой машине (локально).
WEB_PORT=8000

# ===== вход =====
# Ключ HMAC для кодов из писем, не короче 32 символов: openssl rand -base64 48
# Без него коды не переживают перезапуск сервера.
AUTH_SECRET=

# ===== почта (код входа) =====
# resend | smtp | log (пусто — по ключам: RESEND_API_KEY → resend, SMTP_HOST → smtp, иначе log).
# log — код пишется в журнал сервера; только при APP_ENV=development.
MAIL_PROVIDER=
# От кого письма: «Охват <hello@ваш-домен>». До подтверждения домена в Resend — onboarding@resend.dev
# (тогда письма доходят только на почту владельца аккаунта Resend).
MAIL_FROM=
# Resend → API Keys → Create (Sending access).
RESEND_API_KEY=
# SMTP — временно, через ящик Яндекса или Mail.ru (пароль приложения, не пароль от почты):
# smtp.yandex.ru / smtp.mail.ru, порт 465 (TLS) или 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Отправитель для SMTP (должен совпадать с SMTP_USER), пусто — MAIL_FROM.
SMTP_FROM=
# Сколько писем отправляется параллельно (2).
MAIL_WORKERS=

# ===== Telegram (кнопка «Войти через Telegram») =====
# @BotFather → /newbot → токен; /setdomain → домен из PUBLIC_URL. Пусто — кнопка скрыта.
TELEGRAM_BOT_TOKEN=
# Имя бота без @.
TELEGRAM_BOT_NAME=

# ===== Google (кнопка «Войти через Google») =====
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application),
# Authorized redirect URI: ${PUBLIC_URL}/api/auth/google/callback. Пусто — кнопка скрыта.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== лимиты =====
# Срок кода, минут (10); попыток на код (5); пауза между письмами на одну почту, секунд (60);
# писем на почту в час (5); писем с одного адреса в час (20); срок сессии, дней (30).
AUTH_CODE_TTL_MIN=
AUTH_CODE_MAX_ATTEMPTS=
AUTH_CODE_RESEND_SEC=
AUTH_CODE_PER_EMAIL_HOUR=
AUTH_CODE_PER_IP_HOUR=
AUTH_SESSION_DAYS=
# Запросы входа с одного адреса: в секунду (1) и запас подряд (10). Сверх — ответ 429 с Retry-After.
RATE_LIMIT_RPS=
RATE_LIMIT_BURST=

# ===== сборка =====
# Откуда брать базовые образы Docker (зеркало, если Docker Hub недоступен), например mirror.gcr.io/library
REGISTRY=docker.io/library
