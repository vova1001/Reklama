# «Охват» — все настройки только здесь (переменные окружения). Значения секретов в файлах не храним.
# Локально: make env создаст .env и придумает пароль базы. На Render — те же имена в render.yaml / Environment.
# Пусто — значение по умолчанию (указано в скобках).

# ===== режим =====
# production | development (development). В production коды из писем никогда не пишутся в журнал.
APP_ENV=development

# ===== база =====
# Пароль локальной базы docker compose (на своём сервере — обязательно свой).
POSTGRES_PASSWORD=
# Строка подключения — только на Render / внешней базе (локально её собирает docker-compose.yml).
# Neon: postgresql://…neon.tech/neondb?sslmode=require
# DATABASE_URL=

# ===== адрес сайта =====
# Единственный источник адреса: canonical, ссылки, redirect Google (${PUBLIC_URL}/api/auth/google/callback),
# флаг Secure у cookie (https → Secure). Без пути и «/» в конце. В production — только https.
PUBLIC_URL=http://localhost:8000
# Свой сервер (docker-compose.prod.yml): домен для Caddy и сертификата Let's Encrypt, например ohvat.ru
DOMAIN=
# Порт сайта на этой машине (локально).
WEB_PORT=8000

# ===== вход =====
# Ключ HMAC для кодов из писем, не короче 32 символов: openssl rand -base64 48
# Без него коды не переживают перезапуск сервера.
AUTH_SECRET=

# ===== почта (код входа) =====
# resend | smtp | log (пусто — по ключам: RESEND_API_KEY → resend, SMTP_HOST → smtp, иначе log).
# log — код пишется в журнал сервера; только при APP_ENV=development.
MAIL_PROVIDER=
# От кого письма: «Охват <hello@ваш-домен>». До подтверждения домена в Resend — onboarding@resend.dev
# (тогда письма доходят только на почту владельца аккаунта Resend).
MAIL_FROM=
# Resend → API Keys → Create (Sending access).
RESEND_API_KEY=
# SMTP — временно, через ящик Яндекса или Mail.ru (пароль приложения, не пароль от почты):
# smtp.yandex.ru / smtp.mail.ru, порт 465 (TLS) или 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Отправитель для SMTP (должен совпадать с SMTP_USER), пусто — MAIL_FROM.
SMTP_FROM=
# Сколько писем отправляется параллельно (2).
MAIL_WORKERS=

# ===== Telegram: бот @…_bot — вход через бота, команды, уведомления =====
# @BotFather → /newbot → токен. Пусто — Telegram выключен (кнопка скрыта).
TELEGRAM_BOT_TOKEN=
# Имя бота без @ (ссылка t.me/<имя>?start=…), например reklama_auth_bot.
TELEGRAM_BOT_NAME=
# Секрет вебхука: Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token. 1–256 символов A-Z a-z 0-9 _ -:
# openssl rand -hex 32. Без него бот не принимает сообщения (вход через бота выключен, остаётся окно-виджет).
TELEGRAM_WEBHOOK_SECRET=
# Приём сообщений: webhook (по умолчанию при https PUBLIC_URL: setWebhook на ${PUBLIC_URL}/api/telegram/webhook
# при старте) | polling (getUpdates в фоне — локально; снимает вебхук у бота!) | off.
TELEGRAM_MODE=
# Адрес Bot API (https://api.telegram.org). Меняется только для e2e (подставной сервер).
TELEGRAM_API_URL=
# Срок ссылки входа через бота, минут (5); запусков входа через бота с одного адреса в час (30);
# сообщений бота в секунду на всех (25, лимит Telegram — 30).
TELEGRAM_LOGIN_TTL_MIN=
TELEGRAM_LOGIN_PER_IP_HOUR=
TELEGRAM_SEND_RPS=

# ===== Google (кнопка «Войти через Google») =====
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application),
# Authorized redirect URI: ${PUBLIC_URL}/api/auth/google/callback. Пусто — кнопка скрыта.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== лимиты =====
# Срок кода, минут (10); попыток на код (5); пауза между письмами на одну почту, секунд (60);
# писем на почту в час (5); писем с одного адреса в час (20); срок сессии, дней (30).
AUTH_CODE_TTL_MIN=
AUTH_CODE_MAX_ATTEMPTS=
AUTH_CODE_RESEND_SEC=
AUTH_CODE_PER_EMAIL_HOUR=
AUTH_CODE_PER_IP_HOUR=
AUTH_SESSION_DAYS=
# Запросы входа с одного адреса: в секунду (1) и запас подряд (10). Сверх — ответ 429 с Retry-After.
RATE_LIMIT_RPS=
RATE_LIMIT_BURST=
# Весь /api с одного адреса: в секунду (10) и запас (60).
RATE_LIMIT_API_RPS=
RATE_LIMIT_API_BURST=
# /api/me* на одного пользователя: в секунду (5) и запас (30).
RATE_LIMIT_USER_RPS=
RATE_LIMIT_USER_BURST=
# Вебхук бота, на всех: обновлений в секунду (50) и запас (200). Сверх — 429, Telegram повторит.
TELEGRAM_WEBHOOK_RPS=
TELEGRAM_WEBHOOK_BURST=
# Redis (redis://… или rediss://…): общие лимиты нескольких серверов и черновики форм редактора (7 дней).
# На Render — Key Value в том же регионе (Internal URL). Пусто — лимиты в памяти, черновики — в PostgreSQL;
# Redis упал — временно так же, сайт работает.
REDIS_URL=
# Черновик формы — до 64 КБ; сохранений в секунду на пользователя (2) и запас (30).
DRAFT_MAX_KB=
RATE_LIMIT_DRAFT_RPS=
RATE_LIMIT_DRAFT_BURST=

# ===== задания, анкеты, модерация =====
# Заданий на пользователя, все статусы (50). Отправок на проверку в сутки — заданий и анкет вместе (10).
TASKS_MAX_PER_USER=
MODERATION_SUBMITS_PER_DAY=
# Проверка отправленного: auto — публикуется сразу (журнал: «одобрено автоматически»), manual — ждёт модератора (auto).
MODERATION_MODE=

# ===== фото =====
# Где хранить файлы: postgres (по умолчанию; хостинг без диска) или s3 (Cloudflare R2, Яндекс Object Storage, MinIO).
MEDIA_STORE=
# Для MEDIA_STORE=s3: адрес (https://<аккаунт>.r2.cloudflarestorage.com или https://storage.yandexcloud.net),
# корзина, регион (auto — R2, ru-central1 — Яндекс), ключи доступа. Переезд — копия объектов media/ в корзину.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Файл до 10 МБ, на пользователя — 300 МБ и 300 фото. Обработка параллельно — половина ядер (на Render — 1).
MEDIA_MAX_MB=
MEDIA_QUOTA_MB=
MEDIA_MAX_FILES=
MEDIA_WORKERS=
# Загрузок фото на пользователя: в секунду (0.5) и запас (20).
RATE_LIMIT_UPLOAD_RPS=
RATE_LIMIT_UPLOAD_BURST=

# ===== сборка =====
# Откуда брать базовые образы Docker (зеркало, если Docker Hub недоступен), например mirror.gcr.io/library
REGISTRY=docker.io/library
