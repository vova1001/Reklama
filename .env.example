# Скопируйте в .env (make env сделает это сам и придумает пароль). Значения здесь не храним.
# Пароль базы данных (на сервере — обязательно свой).
POSTGRES_PASSWORD=
# Публичный адрес сайта (canonical, sitemap, Open Graph).
PUBLIC_URL=http://localhost:8000
# Порт сайта на этой машине.
WEB_PORT=8000
# Откуда брать базовые образы Docker (зеркало, если Docker Hub недоступен), например mirror.gcr.io/library
REGISTRY=docker.io/library
